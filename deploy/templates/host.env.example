# LocalScale Onion Host mode (safe template; never put private keys here).
LOCALSCALE_ONION_MODE=host
LOCALSCALE_ONION_SERVICE_DIR=/var/lib/localscale/onion
LOCALSCALE_ONION_SERVICE_PORT=80
LOCALSCALE_ONION_UPSTREAM=127.0.0.1:8080
LOCALSCALE_ONION_READY_URL=http://127.0.0.1:8080/healthz
LOCALSCALE_ONION_OPEN_BROWSER=false

# The hostname is generated by Tor in host mode. Read it from hostname only.
# Private key material must remain managed by Tor in LOCALSCALE_ONION_SERVICE_DIR.
