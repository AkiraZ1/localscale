# LocalScale Onion Client mode (safe template; never put private keys here).
LOCALSCALE_ONION_MODE=client
LOCALSCALE_ONION_SERVICE_DIR=/var/lib/localscale/onion-client
LOCALSCALE_ONION_HOSTNAME=replace-with-host-v3-onion-address.onion
LOCALSCALE_ONION_SERVICE_PORT=80
LOCALSCALE_ONION_UPSTREAM=127.0.0.1:8080
LOCALSCALE_ONION_READY_URL=http://replace-with-host-v3-onion-address.onion/
LOCALSCALE_ONION_OPEN_BROWSER=true

# Client mode consumes the host's public .onion address. It does not create a
# HiddenServiceDir and must never receive the host's private key directory.
